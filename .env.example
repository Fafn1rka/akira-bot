# ──────────────────────────────────────────────────────────────────────
# Скопируй этот файл в .env и заполни своими значениями.
# ФАЙЛ .env НИКОГДА НЕ ЗАЛИВАЙ НА GITHUB — там секретные ключи (.gitignore
# уже настроен так, чтобы .env не попал в репозиторий).
# ──────────────────────────────────────────────────────────────────────

# Ключ Gemini — получить бесплатно: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Как Акира будет к тебе обращаться
OWNER_NAME=Создатель

# ── Голос (женский; список голосов: edge-tts --list-voices) ───────────
VOICE_AKIRA=ru-RU-SvetlanaNeural
VOICE_UKRAINIAN=uk-UA-PolinaNeural
VOICE_ENGLISH=en-US-JennyNeural
VOICE_RATE=+0%
VOICE_PITCH=+0Hz

# ── Микрофон ────────────────────────────────────────────────────────
VOICE_INPUT_ENABLED=true
VOICE_WAKE_WORD_REQUIRED=true
VOICE_ENERGY_THRESHOLD=700

# ── Управление компьютером ─────────────────────────────────────────
ENABLE_SYSTEM_COMMANDS=true
# Выполнение консольных команд — ОПАСНО, по умолчанию выключено.
# Даже при true Акира каждый раз спросит подтверждение перед запуском.
ENABLE_TERMINAL_COMMANDS=false

# ── Персонаж на экране ──────────────────────────────────────────────
ENABLE_AVATAR=true
AVATAR_WIDTH=320
AVATAR_CLICK_THROUGH=false

# ── Акира пишет первой ──────────────────────────────────────────────
IDLE_CHAT_ENABLED=true
IDLE_CHAT_INTERVAL=45
IDLE_MAX_PER_DAY=6
# Пусто = активна круглосуточно. Пример тихого времени: 23:00-08:00
QUIET_HOURS=

# ── Telegram ─────────────────────────────────────────────────────────
# Получить токен: напиши @BotFather в Telegram -> /newbot
TELEGRAM_BOT_TOKEN=
# Твой числовой ID — узнать командой /id боту после первого запуска
TELEGRAM_OWNER_ID=
# ID друзей через запятую — им можно просто поболтать (без доступа к ПК)
TELEGRAM_ALLOWED_IDS=
# true — отвечать вообще всем в личке (без доступа к ПК)
TELEGRAM_PUBLIC=false
# video (кружок с говорящей Акирой) | voice (голосовое) | text
TELEGRAM_REPLY_MODE=video
TELEGRAM_TEXT_WITH_MEDIA=true
TELEGRAM_VIDEO_SIZE=384
# Озвучивать ли переписку из Telegram ещё и на компьютере (если ты рядом)
DESKTOP_SPEAKS_TELEGRAM=false

# ── Twitch (необязательно) ───────────────────────────────────────────
TWITCH_CHANNEL=
TWITCH_BOT_NICK=
TWITCH_OAUTH_TOKEN=
