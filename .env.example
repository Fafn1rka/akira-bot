# ──────────────────────────────────────────────────────────────────────
# Скопируй этот файл в .env и заполни своими значениями (install.bat делает это сам).
# ФАЙЛ .env НИКОГДА НЕ ЗАЛИВАЙ НА GITHUB — там секретные ключи (.gitignore
# уже настроен так, чтобы .env не попал в репозиторий).
# ──────────────────────────────────────────────────────────────────────

# ══════════════════ AI ══════════════════
# Достаточно ОДНОГО ключа Gemini (бесплатно: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Хочешь надёжнее — несколько ключей и запасные модели. Когда у одного лимит кончился,
# Акира сама переходит на следующий. Названия моделей сверяй в AI Studio.
# GEMINI_API_KEYS=ключ1,ключ2,ключ3
# GEMINI_MODELS=gemini-3.6-flash,gemini-2.5-flash

# Другие AI как запасные (или основные). Порядок приоритета:
# AI_PROVIDERS=gemini,groq,openrouter,openai,anthropic,ollama
# GROQ_API_KEYS=
# GROQ_MODELS=llama-3.3-70b-versatile
# OPENROUTER_API_KEYS=
# OPENROUTER_MODELS=
# OPENAI_API_KEYS=
# OPENAI_MODELS=gpt-4o-mini
# ANTHROPIC_API_KEYS=
# ANTHROPIC_MODELS=claude-haiku-4-5-20251001
# Локально и бесплатно (без ключа): установи Ollama (ollama.com), затем `ollama pull llama3.1`
# OLLAMA_MODELS=llama3.1
# Любой другой OpenAI-совместимый сервис:
# CUSTOM_BASE_URL=https://.../v1
# CUSTOM_API_KEYS=
# CUSTOM_MODELS=

# Как Акира будет к тебе обращаться
OWNER_NAME=Создатель

# true — голос, Telegram и Discord помнят тебя ВМЕСТЕ (одна память). false — у каждого своя.
SHARED_OWNER_MEMORY=true
# Время, напоминания, веб-поиск, плеер, сценарии, брифинг, экран
ENABLE_EXTRA_TOOLS=true

# ══════════════════ Взгляд на экран ══════════════════
# «Акира, посмотри на экран» — скриншот уходит выбранному AI, но только по твоей просьбе.
# (Linux: работает в сессии X11, не в Wayland.)
ENABLE_SCREEN_VISION=true
# 1 = основной монитор, 2 = второй, 0 = все сразу
SCREEN_MONITOR=1

# ══════════════════ Утренний брифинг ══════════════════
# В это время Акира сама здоровается: день, погода, твои напоминания. Раз в день.
MORNING_BRIEFING=true
BRIEFING_TIME=08:30
# Город для погоды (например Berlin или Киев). Пусто — без погоды.
BRIEFING_CITY=

# Сценарии («включи рабочий режим») — в файле data/scenes.json, он создастся сам при первом запуске.

# ══════════════════ Музыка ══════════════════
# «Акира, включи <песня/исполнитель>» — сначала ищет тут, потом на YouTube.
# Пусто — папка «Музыка» пользователя.
MUSIC_DIR=
MUSIC_YOUTUBE_FALLBACK=true

# Включать конкретные треки прямо в твоём Spotify (нужен Premium). Получить:
# developer.spotify.com/dashboard -> Create app -> Redirect URI ТОЧНО http://127.0.0.1:8888/callback
# Потом один раз: spotify_login.bat
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Присылать в Telegram/Discord ссылки, которые Акира сама находит (музыка, web_search)
LINKS_NOTIFY=true

# ══════════════════ Картинки ══════════════════
# «Акира, нарисуй ...». auto — сама выберет: OpenAI (если есть ключ) -> Gemini (если есть ключ) ->
# Pollinations.ai (бесплатно, без ключа). Явно: openai | gemini | pollinations
IMAGE_PROVIDER=auto
# IMAGE_MODEL_GEMINI=imagen-4.0-generate-001
# IMAGE_MODEL_OPENAI=dall-e-3

# ══════════════════ Голос ══════════════════
# ── Озвучка (женские голоса; список: edge-tts --list-voices) ──
VOICE_AKIRA=ru-RU-SvetlanaNeural
VOICE_UKRAINIAN=uk-UA-PolinaNeural
VOICE_ENGLISH=en-US-JennyNeural
VOICE_RATE=+0%
VOICE_PITCH=+0Hz
# Нет интернета — озвучить встроенным голосом Windows
VOICE_OFFLINE_FALLBACK=true

# ── Микрофон ──
VOICE_INPUT_ENABLED=true
VOICE_WAKE_WORD_REQUIRED=true
# 0 = порог громкости подбирается сама. Число (например 700) — задать вручную.
VOICE_ENERGY_THRESHOLD=0
# Какой микрофон использовать: пусто = по умолчанию; номер или часть названия. Список: test_mic.bat
VOICE_MIC_DEVICE=
VOICE_CONVERSATION_WINDOW=25
WAKE_WORDS=акира,акіра,akira

# ── Распознавание речи ──
# auto — локальный whisper, если установлен (requirements-whisper.txt), иначе google
STT_ENGINE=auto
VOICE_INPUT_LANG=ru-RU
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# ══════════════════ Управление компьютером ══════════════════
ENABLE_SYSTEM_COMMANDS=true
# Выполнение консольных команд — ОПАСНО, по умолчанию выключено.
# Даже при true Акира каждый раз спросит подтверждение перед запуском.
ENABLE_TERMINAL_COMMANDS=false

# ══════════════════ Персонаж на экране ══════════════════
ENABLE_AVATAR=true
AVATAR_WIDTH=320
AVATAR_CLICK_THROUGH=false

# ══════════════════ Акира пишет первой ══════════════════
IDLE_CHAT_ENABLED=true
IDLE_CHAT_INTERVAL=45
IDLE_MAX_PER_DAY=6
# Пусто = активна круглосуточно. Пример тихого времени: 23:00-08:00
QUIET_HOURS=

# ══════════════════ Telegram ══════════════════
# Получить токен: напиши @BotFather в Telegram -> /newbot
TELEGRAM_BOT_TOKEN=
# Твой числовой ID — узнать командой /id боту после первого запуска
TELEGRAM_OWNER_ID=
# ID друзей через запятую — им можно просто поболтать (без доступа к ПК)
TELEGRAM_ALLOWED_IDS=
# true — отвечать вообще всем в личке (без доступа к ПК)
TELEGRAM_PUBLIC=false
# video (кружок с говорящей Акирой) | voice (голосовое) | text
TELEGRAM_REPLY_MODE=video
TELEGRAM_TEXT_WITH_MEDIA=true
TELEGRAM_VIDEO_SIZE=384
# Озвучивать ли переписку из Telegram ещё и на компьютере (если ты рядом)
DESKTOP_SPEAKS_TELEGRAM=false

# ══════════════════ Discord (необязательно) ══════════════════
# Инструкция — в начале файла discord_bot.py и в README
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=
# Каналы (ID через запятую), где отвечать на все сообщения. Пусто = только личка и @Акира
DISCORD_CHANNEL_IDS=
DISCORD_ALLOW_GUESTS=true
# Консоль через Discord — ОПАСНО, лучше не включать
DISCORD_ALLOW_TERMINAL=false
# Голос в голосовом канале (команда «!зайди»): true — озвучивать ответы и гостям, false — только тебе
DISCORD_VOICE_ALL=false

# ══════════════════ Twitch (необязательно) ══════════════════
TWITCH_CHANNEL=
TWITCH_BOT_NICK=
TWITCH_OAUTH_TOKEN=
